{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky-window",
  "description": "Minimal window permissions for independent StickyFlow note windows",
  "windows": ["sticky-*"],
  "permissions": [
    "core:window:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close"
  ]
}
