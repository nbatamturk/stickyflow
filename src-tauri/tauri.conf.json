{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyFlow",
  "version": "0.1.0",
  "identifier": "dev.nbatamturk.stickyflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StickyFlow",
        "width": 900,
        "height": 680,
        "minWidth": 420,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Secure local-first sticky notes and snippet manager",
    "longDescription": "StickyFlow is a lightweight local-first desktop notes app with encrypted note storage, sticky windows, snippets, optional password lock, autostart, encrypted backups and plaintext portability tools.",
    "homepage": "https://github.com/nbatamturk/stickyflow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
